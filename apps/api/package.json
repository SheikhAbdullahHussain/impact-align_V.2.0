{
  "name": "@impactalign/api",
  "version": "0.1.0",
  "private": true,
  "description": "ImpactAlign SDG REST API (Node.js + Express + MongoDB)",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "openapi:export": "tsx src/openapi/export.ts"
  },
  "dependencies": {
    "@impactalign/config": "*",
    "@impactalign/database": "*",
    "@impactalign/types": "*",
    "@impactalign/validation": "*",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15"
  }
}
