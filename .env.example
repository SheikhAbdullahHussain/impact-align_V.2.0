# ImpactAlign SDG — environment template.
# Copy to `.env` for local development:  cp .env.example .env
# NEVER commit `.env` or put real secrets in this file. Every "change-me" value is a placeholder;
# the API refuses to start in production while a placeholder credential is present.

# ---- Runtime -------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# ---- API (apps/api) -------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=4000
# Comma-separated browser origins allowed to call the API (https:// only in production).
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Number of reverse-proxy hops in front of the API (0 = none). Required for correct client IPs.
API_TRUST_PROXY=0
# Swagger UI at /docs. Development only — startup fails if enabled in production.
API_SWAGGER_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
HEALTH_CHECK_TIMEOUT_MS=2000

# ---- Data stores ----------------------------------------------------------
# Docker dev containers use these credentials (see infrastructure/docker).
MONGO_ROOT_USER=impactalign
MONGO_ROOT_PASSWORD=change-me-mongo
REDIS_PASSWORD=change-me-redis
# If a password contains special characters it must be URL-encoded inside these URIs.
MONGODB_URI=mongodb://impactalign:change-me-mongo@localhost:27017/impactalign?authSource=admin
REDIS_URL=redis://:change-me-redis@localhost:6379

# ---- Web / Admin (public values only — anything NEXT_PUBLIC_* is visible to browsers) ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Dashboard UI preview (no login exists yet). Always on outside production; in production it stays
# hidden (404) unless this is exactly 'true'. Leave unset until authentication is implemented.
# DASHBOARD_PREVIEW_ENABLED=false

# ---- Reserved for later phases (not read yet) ------------------------------
# SMTP_URL=
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# LLM_PROVIDER=
# LLM_API_KEY=
